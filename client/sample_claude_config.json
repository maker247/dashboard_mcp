{
  "_comment": "Add this entry under 'mcpServers' inside your claude_desktop_config.json",
  "mcpServers": {
    "odoo_dashboard": {
      "command": "/path/to/client/.venv/bin/python",
      "args": [
        "/path/to/client/odoo_mcp_client.py",
        "--server",
        "http://YOUR_ODOO_SERVER_IP:8095/sse"
      ],
      "env": {
        "PYTHONUNBUFFERED": "1"
      }
    }
  },
  "_windows_example": {
    "odoo_dashboard": {
      "command": "C:\\Users\\Username\\odoo_client\\.venv\\Scripts\\python.exe",
      "args": [
        "C:\\Users\\Username\\odoo_client\\odoo_mcp_client.py",
        "--server",
        "http://YOUR_ODOO_SERVER_IP:8095/sse"
      ]
    }
  },
  "_mac_config_location": "~/Library/Application Support/Claude/claude_desktop_config.json",
  "_windows_config_location": "%APPDATA%\\Claude\\claude_desktop_config.json"
}
