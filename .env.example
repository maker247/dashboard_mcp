# ==============================================================================
# OPTIONAL: Backend MCP Server Settings (.env)
# ==============================================================================
# NOTE: The backend MCP server is completely stateless.
# Do NOT put ODOO_USER or ODOO_API_KEY here.
# User credentials belong exclusively in the client's .env (dashboard_mcp_client/.env).
#
# MCP_SERVER_HOST=127.0.0.1
# MCP_SERVER_PORT=8095
# MCP_SERVER_NAME=odoo-dashboard-mcp
# STRICT_READ_ONLY=1
